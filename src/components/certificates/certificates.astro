---
import { certificatesData } from "@lib/certificates.data";
import { ExternalLink, ArrowUpRight, X } from "lucide-astro";

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<section id="certificates" class="section">
  <div class="container mx-auto max-w-7xl">

    <header class="section-header overflow-hidden">
      <h2 class="section-title cert-title">
        My <span class="italic font-light text-primary">Certificates</span>
      </h2>
    </header>

    <div class="space-y-16 lg:space-y-24">
      {
        certificatesData.map((item, index) => {
          const modalId = `cert-modal-${index}`;
          const titleId = `cert-modal-title-${index}`;
          return (
            <article class="cert-item grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start" data-index={index}>

              <!-- Certificate details -->
              <div class="lg:col-span-7 space-y-10">
                <div class="space-y-8">
                  <div class="cert-element bg-primary text-primary-content inline-block px-4 py-1 text-[10px] font-mono tracking-[0.3em] uppercase font-bold">
                    {item.credentialType}
                  </div>

                  <h3 class="cert-element text-4xl md:text-5xl font-black uppercase italic leading-tight tracking-tighter max-w-2xl">
                    {item.title}
                  </h3>

                  {item.issuerUrl ? (
                    <a href={item.issuerUrl} target="_blank" rel="noopener noreferrer" class="cert-element cert-issuer-link inline-flex items-center gap-2 text-xs font-black uppercase tracking-widest opacity-40 hover:opacity-100 hover:text-primary transition-all">
                      {item.issuer} <ArrowUpRight size={14} class="cert-arrow" />
                    </a>
                  ) : (
                    <span class="cert-element text-xs font-black uppercase tracking-widest opacity-40">{item.issuer}</span>
                  )}

                  <p class="cert-element text-lg md:text-xl font-medium leading-relaxed max-w-3xl text-base-content/80">
                    {item.description}
                  </p>
                </div>

                <div class="cert-element grid grid-cols-1 sm:grid-cols-3 gap-px bg-base-300 border border-base-300">
                  <div class="p-6 bg-base-100">
                    <p class="text-[10px] font-mono uppercase tracking-widest text-primary font-bold">Academy</p>
                    <p class="text-xs font-bold uppercase leading-relaxed">{item.academy}</p>
                  </div>
                  <div class="p-6 bg-base-100">
                    <p class="text-[10px] font-mono uppercase tracking-widest text-primary font-bold">Location</p>
                    <p class="text-xs font-bold uppercase">{item.location}</p>
                  </div>
                  <div class="p-6 bg-base-100">
                    <p class="text-[10px] font-mono uppercase tracking-widest text-primary font-bold">Issued</p>
                    <p class="text-xs font-bold uppercase">{formatDate(item.date)}</p>
                  </div>
                </div>
              </div>

              <!-- Certificate preview / modal trigger -->
              <div class="lg:col-span-5">
                <button
                  type="button"
                  class="cert-element group relative block w-full overflow-hidden border-2 border-base-300 bg-base-200 cursor-zoom-in text-left"
                  onclick={`document.getElementById('${modalId}').showModal()`}
                  aria-haspopup="dialog"
                  aria-controls={modalId}
                >
                  <img
                    src={item.previewImage}
                    alt={`${item.title} — ${item.issuer}`}
                    width={1684}
                    height={1191}
                    loading="lazy"
                    class="cert-preview w-full h-auto object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                  />
                  <span class="absolute inset-0 bg-base-content/0 group-hover:bg-base-content/10 transition-colors duration-300"></span>
                  <span class="absolute bottom-4 right-4 flex items-center gap-2 bg-primary text-primary-content px-4 py-2 text-[10px] font-mono tracking-[0.2em] uppercase font-bold">
                    <ExternalLink size={14} /> Preview
                  </span>
                </button>

                <div class="cert-element flex flex-wrap gap-4 mt-6">
                  <button
                    type="button"
                    class="btn btn-primary rounded-none tracking-[0.2em] text-[10px] sm:text-xs border-2 uppercase"
                    onclick={`document.getElementById('${modalId}').showModal()`}
                  >
                    <ExternalLink size={14} /> View Certificate
                  </button>
                </div>
              </div>

              <!-- Modal -->
              <dialog id={modalId} class="modal" aria-labelledby={titleId}>
                <div class="modal-box w-11/12 max-w-5xl max-h-[90dvh] rounded-none border-2 border-base-300 bg-base-100 p-0 overflow-hidden flex flex-col">
                  <div class="shrink-0 flex items-start justify-between gap-4 p-6 border-b border-base-300">
                    <div class="min-w-0">
                      <p class="text-[10px] font-mono uppercase tracking-widest text-primary font-bold">{item.credentialType}</p>
                      <h3 id={titleId} class="text-xl md:text-2xl font-black uppercase italic leading-tight tracking-tighter">{item.title}</h3>
                      <p class="text-xs font-black uppercase tracking-widest opacity-40 mt-1">{item.issuer}</p>
                    </div>
                    <form method="dialog">
                      <button type="submit" class="btn btn-sm btn-circle btn-ghost shrink-0" aria-label="Close certificate preview">
                        <X size={18} />
                      </button>
                    </form>
                  </div>

                  <div class="flex-1 min-h-0 overflow-auto p-6 bg-base-200/50">
                    <img
                      src={item.previewImage}
                      alt={`${item.title} — ${item.issuer}`}
                      width={1684}
                      height={1191}
                      class="w-full h-auto"
                    />
                  </div>

                  <div class="shrink-0 flex flex-wrap justify-end gap-3 p-6 border-t border-base-300">
                    <a href={item.file} target="_blank" rel="noopener noreferrer" class="btn btn-primary rounded-none tracking-[0.2em] text-[10px] sm:text-xs border-2 uppercase">
                      <ExternalLink size={14} /> Open in new window
                    </a>
                    <form method="dialog">
                      <button type="submit" class="btn btn-ghost rounded-none tracking-[0.2em] text-[10px] sm:text-xs uppercase">Close</button>
                    </form>
                  </div>
                </div>
                <form method="dialog" class="modal-backdrop">
                  <button aria-label="Close">close</button>
                </form>
              </dialog>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  import { initCertificates } from "./certificates.ts";
  initCertificates();
  document.addEventListener("astro:page-load", initCertificates);
</script>
